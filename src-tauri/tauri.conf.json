{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roto Now",
  "version": "0.5.2",
  "identifier": "com.rotonow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RotoNow",
        "width": 1400,
        "height": 1050,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#090b0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/roto-now/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "resources": [
      "bin/ffmpeg.exe",
      "bin/ffprobe.exe",
      "model-manifest.json",
      "windows/install-required-models.ps1",
      "THIRD_PARTY_NOTICES.md"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "../scripts/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English"],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "shortDescription": "Local AI-assisted rotoscoping",
    "longDescription": "Remove image backgrounds and create green or blue screen video locally."
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/pakoramaster/roto-now/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBMEU5NTM3NUE4MEUxMzYKUldRMjRZQmFONVVPZWw0a3RVYVV6dnBMczVIZnJrWUFiallCZ2JaY0FsVHY4TW9wK24zYjBSZEEK",
      "windows": { "installMode": "passive" }
    }
  }
}
