{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roto Now",
  "version": "0.1.1",
  "identifier": "com.rotonow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Roto Now",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#090b0a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "resources": [
      "bin/ffmpeg.exe",
      "bin/ffprobe.exe",
      "models/birefnet-general-lite.onnx",
      "THIRD_PARTY_NOTICES.md"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Local AI-assisted rotoscoping",
    "longDescription": "Remove image backgrounds and create green or blue screen video locally."
  }
}
